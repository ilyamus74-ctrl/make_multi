      return { ...cmd, mode: 'track' };
    }
    const r = readReacquireParams();
    const now = Date.now();
    if (!reacquireState.active) {
      reacquireState.active = true;
      reacquireState.lostSince = now;
      reacquireState.scanStep = 0;
      reacquireState.reason = cmd.mode;
      postOpsEvent('track_reacquire_start', { reason: cmd.mode });
    }
    const lostMs = now - reacquireState.lostSince;
    if (lostMs >= r.maxLostSec * 1000) {
      pidState.targetText = `reacquire timeout ${r.maxLostSec.toFixed(1)}s`;
      telemetryState.reacquireMode = 'timeout';
      telemetryState.reacquireLostMs = Math.round(lostMs);
      telemetryState.reacquireScanStep = reacquireState.scanStep;
      finishReacquireSession('timeout');
      postOpsEvent('track_reacquire_timeout', {
        max_lost_sec: Number(r.maxLostSec.toFixed(1)),
        lost_ms: Math.round(lostMs),
      });
      if ($('controlMode').value === 'auto') {
        $('controlMode').value = 'assist';
        syncControlModeUi();
        saveSettings();
        panicStop('reacquire-timeout');
      }
      return { ...cmd, pan: 0, tilt: 0, mode: 'reacquire-timeout' };
    }
    if (lostMs < r.holdMs) {
      const pan = Math.round(reacquireState.lastSeenPan * 0.6);
      const tilt = Math.round(reacquireState.lastSeenTilt * 0.6);
      pidState.targetText = `reacquire hold ${Math.round(lostMs)}ms`;
      telemetryState.reacquireMode = 'hold';
      telemetryState.reacquireLostMs = Math.round(lostMs);
      telemetryState.reacquireScanStep = reacquireState.scanStep;
      return { ...cmd, pan, tilt, mode: 'reacquire-hold' };
    }
    reacquireState.scanStep += 1;
    const dir = (Math.floor(reacquireState.scanStep / r.panCadence) % 2) === 0 ? 1 : -1;
    const pan = dir * r.panStep;
    const tilt = (reacquireState.scanStep % r.tiltCadence === 0) ? r.tiltStep : 0;
    pidState.targetText = `reacquire scan ${Math.round(lostMs / 1000)}s`;
    telemetryState.reacquireMode = 'scan';
    telemetryState.reacquireLostMs = Math.round(lostMs);
    telemetryState.reacquireScanStep = reacquireState.scanStep;
    return { ...cmd, pan, tilt, mode: 'reacquire-scan' };
  }

