  async function refreshDetectorConfig() {
    try {
      const res = await fetch('/api/detector/config', { cache: 'no-store' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const cfg = await res.json();
      setDetectorToggleState(parseBool(cfg.detect_enabled, false));
      const currentModel = String(cfg.current_model || '');
      detectorSelectedClasses = Array.isArray(cfg.selected_classes) ? cfg.selected_classes.map(v => Number(v)).filter(Number.isFinite) : [];
      setDetectorMeta(currentModel);
      await refreshDetectorModels(currentModel);
      await refreshDetectorClasses(detectorClassSource, detectorSelectedClasses);
      if (!detectorModelSwitching) setDetectorSwitchState('idle');
      saveSettings();
    } catch (_) {
      setDetectorMeta('unavailable');
      await refreshDetectorModels('');
      await refreshDetectorClasses(detectorClassSource, []);
      setDetectorSwitchState('unavailable');
    }
  }

  async function selectDetectorModel(modelName) {
    const model = String(modelName || '').trim();
    if (!model) return;

    const now = Date.now();
    if (now < detectorModelCooldownUntil) {
      setDetectorSwitchState(`cooldown ${Math.ceil((detectorModelCooldownUntil - now) / 1000)}s`);
      return;
    }
    if ($('controlMode').value === 'auto' && telemetryState.linkMode === 'critical') {
      setDetectorSwitchState('deferred:auto-critical');
      return;
    }
    detectorModelSwitching = true;
    setDetectorSwitchState('switching...', true);
    try {
      const ctl = new AbortController();
      const timer = setTimeout(() => ctl.abort(), 6000);
      const res = await fetch('/api/detector/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: ctl.signal,
        body: JSON.stringify({ current_model: model }),
      });
      clearTimeout(timer);
      let payload = {};
      try { payload = await res.json(); } catch (_) {}
      if (payload && payload.model_switch_error === 'cooldown') {
        detectorModelCooldownUntil = Date.now() + 10000;
        setDetectorSwitchState('cooldown 10s');
      } else if (payload && payload.model_switch_error) {
        setDetectorSwitchState(`rollback:${payload.model_switch_error}`);
      } else {
        setDetectorSwitchState('ok');
      }
    } catch (_) {}
    detectorModelSwitching = false;
    await refreshDetectorConfig();
  }

