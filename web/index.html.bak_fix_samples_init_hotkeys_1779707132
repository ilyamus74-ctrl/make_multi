  function computeAlertState(eventsSummary) {
    const counts = (eventsSummary && typeof eventsSummary.counts === 'object') ? eventsSummary.counts : {};
    const videoLost = Number(counts.video_lost || 0);
    const videoRestored = Number(counts.video_restored || 0);
    const videoRetry = Number(counts.video_retry || 0);
    telemetryState.unresolvedVideoLost = Math.max(0, videoLost - videoRestored);
    telemetryState.recentRetries = Math.max(0, videoRetry);

    let level = 'ok';
    let text = 'OK';
    const detAgeMs = Number(telemetryState.detAgeMs);
    const detAgeWarn = Number.isFinite(detAgeMs) && detAgeMs >= 1500;
    const detAgeAlarm = Number.isFinite(detAgeMs) && detAgeMs >= 3000;

    const jitterMs = Number(telemetryState.pingJitterMs);
    const jitterWarn = Number.isFinite(jitterMs) && jitterMs >= ALERT_WARN_JITTER_MS;
    const jitterAlarm = Number.isFinite(jitterMs) && jitterMs >= ALERT_ALARM_JITTER_MS;
    const detBitrateKbps = Number(telemetryState.detBitrateKbps);
    const detBitrateWarn = Number.isFinite(detBitrateKbps) && detBitrateKbps > 0 && detBitrateKbps <= ALERT_WARN_DET_BITRATE_KBPS;
    const detBitrateAlarm = Number.isFinite(detBitrateKbps) && detBitrateKbps > 0 && detBitrateKbps <= ALERT_ALARM_DET_BITRATE_KBPS;
    if (telemetryState.linkMode === 'critical' || streamLostHard || telemetryState.unresolvedVideoLost > 0) {
      level = 'alarm';
      text = `ALARM:${telemetryState.unresolvedVideoLost}`;
    } else if (detAgeAlarm) {
      level = 'alarm';
      text = `ALARM:AGE${Math.round(detAgeMs)}ms`;
    } else if (jitterAlarm) {
      level = 'alarm';
      text = `ALARM:JIT${Math.round(jitterMs)}ms`;
    } else if (detBitrateAlarm) {
      level = 'alarm';
      text = `ALARM:DETBR${detBitrateKbps.toFixed(1)}`;
    } else if (telemetryState.linkMode === 'safe' || telemetryState.recentRetries > 0) {
      level = 'warn';
      text = `WARN:${telemetryState.recentRetries}`;
    } else if (detAgeWarn) {
      level = 'warn';
      text = `WARN:AGE${Math.round(detAgeMs)}ms`;
    } else if (jitterWarn) {
      level = 'warn';
      text = `WARN:JIT${Math.round(jitterMs)}ms`;
    } else if (detBitrateWarn) {
      level = 'warn';
      text = `WARN:DETBR${detBitrateKbps.toFixed(1)}`;
    }

    telemetryState.alertState = level;
    telemetryState.alertText = text;
  }

  async function tickTelemetry() {
    const pingStarted = performance.now();
    try {
      const pingRes = await fetch('/api/ping', { cache: 'no-store' });
      if (pingRes.ok) {
        const pingData = await pingRes.json();
        const measuredRtt = Math.max(1, Math.round(performance.now() - pingStarted));
        if (telemetryState.pingPrevRttMs == null) {
          telemetryState.pingJitterMs = 0;
        } else {
          const jitterSample = Math.abs(measuredRtt - telemetryState.pingPrevRttMs);
          if (telemetryState.pingJitterMs == null) {
            telemetryState.pingJitterMs = jitterSample;
          } else {
            telemetryState.pingJitterMs = Math.round(telemetryState.pingJitterMs * 0.7 + jitterSample * 0.3);
          }
        }
        telemetryState.pingPrevRttMs = measuredRtt;
        telemetryState.pingRttMs = measuredRtt;
        const uptimeSec = Number(pingData?.uptime_s);
        const memRssKb = Number(pingData?.mem_rss_kb);
        const load1 = Number(pingData?.loadavg_1m);
        telemetryState.serverUptimeSec = Number.isFinite(uptimeSec) ? Math.max(0, uptimeSec) : null;
        telemetryState.serverMemRssKb = Number.isFinite(memRssKb) ? Math.max(0, memRssKb) : null;
        telemetryState.serverLoad1 = Number.isFinite(load1) ? Math.max(0, load1) : null;
      }
    } catch (_) {
      telemetryState.pingRttMs = null;
      telemetryState.pingPrevRttMs = null;
      telemetryState.pingJitterMs = null;
      telemetryState.serverUptimeSec = null;
      telemetryState.serverMemRssKb = null;
      telemetryState.serverLoad1 = null;
    }

    if (telemetryState.pingRttMs == null) {
      telemetryState.highRttStreak = Math.min(5, telemetryState.highRttStreak + 1);
      telemetryState.criticalRttStreak = Math.min(5, telemetryState.criticalRttStreak + 1);
    } else {
      telemetryState.highRttStreak = telemetryState.pingRttMs >= LINK_SAFE_RTT_MS ? Math.min(5, telemetryState.highRttStreak + 1) : 0;
      telemetryState.criticalRttStreak = telemetryState.pingRttMs >= LINK_CRITICAL_RTT_MS ? Math.min(5, telemetryState.criticalRttStreak + 1) : 0;
    }
    if (telemetryState.criticalRttStreak >= 2) {
      await setLinkMode('critical', 'rtt-critical');
    } else if (telemetryState.highRttStreak >= 2) {
      await setLinkMode('safe', 'rtt-high');
    } else if (telemetryState.linkMode !== 'normal') {
      await setLinkMode('normal', 'rtt-restored');
    }

    try {
      const detRes = await fetch('/api/detections', { cache: 'no-store' });
      if (detRes.ok) {
        const det = await detRes.json();
        ingestDetections(det);
        const frameId = Number(det.frameId || 0);
        const now = Date.now();
        if (telemetryState.lastFrameId != null && frameId >= telemetryState.lastFrameId) {
          const frameDelta = frameId - telemetryState.lastFrameId;
          const timeDeltaSec = Math.max(0.001, (now - telemetryState.lastFrameTs) / 1000);
          telemetryState.detFps = frameDelta / timeDeltaSec;
          telemetryState.droppedFrames = Math.max(0, frameDelta - 1);
          const sampleLoss = frameDelta > 0 ? (telemetryState.droppedFrames / frameDelta) * 100 : 0;
          if (telemetryState.packetLossPct == null) {
            telemetryState.packetLossPct = sampleLoss;
          } else {
            telemetryState.packetLossPct = telemetryState.packetLossPct * 0.75 + sampleLoss * 0.25;
          }
          const contentLength = Number(detRes.headers.get('content-length') || '0');
          const payloadBytes = contentLength > 0 ? contentLength : JSON.stringify(det).length;
          const sampleBitrateKbps = (payloadBytes * 8) / timeDeltaSec / 1000;
          if (telemetryState.detBitrateKbps == null) {
            telemetryState.detBitrateKbps = sampleBitrateKbps;
          } else {
            telemetryState.detBitrateKbps = telemetryState.detBitrateKbps * 0.75 + sampleBitrateKbps * 0.25;
          }
        }
        const fused = Number(det.confidence?.fused);
        telemetryState.fusedConfidence = Number.isFinite(fused) ? clamp(fused, 0, 1) : null;
        telemetryState.lastFrameId = frameId;
        telemetryState.lastFrameTs = now;
        telemetryState.detAgeMs = 0;
        try {
          const trRes = await fetch('/api/tracker/state', { cache: 'no-store' });
          if (trRes.ok) {
            const tr = await trRes.json();
            const sid = Number(tr.selected_track_id || 0);
            selectedTargetId = sid > 0 ? sid : null;
            $('pidSelectedId').textContent = selectedTargetId == null ? 'auto' : String(selectedTargetId);
          }
        } catch (_) {}
      }
    } catch (_) {
      telemetryState.detFps = null;
      telemetryState.droppedFrames = null;
      telemetryState.packetLossPct = null;
      telemetryState.detBitrateKbps = null;
      telemetryState.fusedConfidence = null;
      telemetryState.detAgeMs = null;
    }

    try {
      const confRes = await fetch('/api/tracking/confidence', { cache: 'no-store' });
      if (confRes.ok) {
        const conf = await confRes.json();
        const fusedRaw = Number(conf?.fused_raw);
        telemetryState.confidenceFusedRaw = Number.isFinite(fusedRaw) ? clamp(fusedRaw, 0, 1) : null;
        const appliedRev = Number(conf?.applied_config?.revision);
        telemetryState.confidenceConfigAppliedRev = Number.isFinite(appliedRev) ? Math.max(1, Math.round(appliedRev)) : null;
        if (telemetryState.confidenceConfigRequestedRev == null && telemetryState.confidenceConfigAppliedRev != null) {
          telemetryState.confidenceConfigRequestedRev = telemetryState.confidenceConfigAppliedRev;
        }
        const layers = Array.isArray(conf?.layers) ? conf.layers : [];
        telemetryState.confidenceLayerScores = [0, 1, 2, 3].map(idx => {
          const score = Number(layers[idx]?.score);
          return Number.isFinite(score) ? clamp(score, 0, 1) : null;
        });
      } else {
        telemetryState.confidenceFusedRaw = null;
        telemetryState.confidenceConfigAppliedRev = null;
        telemetryState.confidenceLayerScores = null;
      }
    } catch (_) {
      telemetryState.confidenceFusedRaw = null;
      telemetryState.confidenceConfigAppliedRev = null;
      telemetryState.confidenceLayerScores = null;
    }
    if (telemetryState.lastFrameTs > 0) {
      telemetryState.detAgeMs = Math.max(0, Math.round(Date.now() - telemetryState.lastFrameTs));
    }
    try {
      const rangeRes = await fetch('/api/range_estimate', { cache: 'no-store' });
      if (rangeRes.ok) {
        const rangeData = await rangeRes.json();
        const distanceM = Number(rangeData.distance_m);
        const minM = Number(rangeData.min_m);
        const maxM = Number(rangeData.max_m);
        const confidence = Number(rangeData.confidence);
        const className = typeof rangeData.class_name === 'string' ? rangeData.class_name.trim() : '';
        telemetryState.rangeEstimateM = Number.isFinite(distanceM) ? Math.max(0, distanceM) : null;
        telemetryState.rangeMinM = Number.isFinite(minM) ? Math.max(0, minM) : null;
        telemetryState.rangeMaxM = Number.isFinite(maxM) ? Math.max(0, maxM) : null;
        telemetryState.rangeConfidence = Number.isFinite(confidence) ? clamp(confidence, 0, 1) : null;
        telemetryState.rangeClassName = className || null;
      } else {
        telemetryState.rangeEstimateM = null;
        telemetryState.rangeMinM = null;
        telemetryState.rangeMaxM = null;
        telemetryState.rangeConfidence = null;
        telemetryState.rangeClassName = null;
      }
    } catch (_) {
      telemetryState.rangeEstimateM = null;
      telemetryState.rangeMinM = null;
      telemetryState.rangeMaxM = null;
      telemetryState.rangeConfidence = null;
      telemetryState.rangeClassName = null;
    }
    try {
      const summaryRes = await fetch('/api/events/summary', { cache: 'no-store' });
      if (summaryRes.ok) {
        const payload = await summaryRes.json();
        computeAlertState(payload);
      } else {
        computeAlertState(null);
      }
    } catch (_) {
      computeAlertState(null);
    }

    updateTelemetryUi();
  }

  function startTelemetry() {
    if (telemetryTimer) clearInterval(telemetryTimer);
    telemetryTimer = setInterval(() => { tickTelemetry(); }, 1000);
    tickTelemetry();
  }
  function loadMjpeg(url) {
    const frame = $('mjpegFrame');
    const img = $('mjpegImg');
    const mode = $('streamMode').value;
    if (!url) {
      setStreamStatus('LOST');
      $('streamState').textContent = 'empty url';
      return;
    }

    saveSettings();
    clearStreamRetry();
    streamReloadToken += 1;
    const reloadToken = streamReloadToken;
    setStreamStatus('RECONNECTING');
    $('streamState').textContent = 'loading...';
    if (mode === 'img') {
      frame.classList.add('hidden');
      img.classList.remove('hidden');
      frame.src = 'about:blank';
      img.src = '';
      img.src = appendNoCache(url, reloadToken);
      scheduleStreamRetry();
      return;
    }
    img.classList.add('hidden');
    frame.classList.remove('hidden');
    img.src = '';
    frame.src = 'about:blank';

    frame.src = appendNoCache(url, reloadToken);
    scheduleStreamRetry();
  }

  function updateMicrostepLegend() {
    $('msLegend').textContent = swapMicroButtons
      ? 'X←  B→  A↑  Y↓'
      : 'X←  B→  A↓  Y↑';
  }
  function parseBool(value, fallback = false) {
    if (typeof value === 'boolean') return value;
    if (typeof value === 'number') return value !== 0;
    if (typeof value === 'string') {
      const normalized = value.trim().toLowerCase();
      if (normalized === 'true' || normalized === '1' || normalized === 'yes' || normalized === 'on') return true;
      if (normalized === 'false' || normalized === '0' || normalized === 'no' || normalized === 'off') return false;
    }
    return fallback;
  }


  function appendNoCache(url, token) {
    const sep = url.includes('?') ? '&' : '?';
    return `${url}${sep}r=${Date.now()}_${token}`;
  }

  function clearStreamRetry() {
    if (!streamRetryTimer) return;
    clearTimeout(streamRetryTimer);
    streamRetryTimer = null;
    streamRetryAttempt = 0;
  }

  function scheduleStreamRetry() {
    if (streamRetryTimer) return;

    const delays = [1000, 2000, 5000, 10000];
    const delay = delays[Math.min(streamRetryAttempt, delays.length - 1)];
    streamRetryAttempt += 1;
    setStreamStatus(delay >= 10000 ? 'LOST' : 'RECONNECTING');
    postOpsEvent('video_retry', { attempt: streamRetryAttempt, delay_ms: delay, mode: 'auto' });
    streamRetryTimer = setTimeout(() => {
      streamRetryTimer = null;
      if (!$('auto').checked) {
        setStreamStatus('LOST');
        $('streamState').textContent = 'stream stopped (auto-connect off)';
        return;
      }
      setStreamStatus('RECONNECTING');
      $('streamState').textContent = `retry #${streamRetryAttempt}`;
      loadMjpeg(($('mjpegUrl').value || '').trim());

    }, delay);
  }

  function forceRetryStream() {
    clearStreamRetry();
    streamRetryAttempt = 0;
    setStreamStatus('RECONNECTING');
    $('streamState').textContent = 'manual retry';
    postOpsEvent('video_retry', { attempt: 0, delay_ms: 0, mode: 'manual' });
    loadMjpeg(($('mjpegUrl').value || '').trim());
  }

  async function resetUiCache() {
    try {
      if ('caches' in window && caches.keys) {
        const keys = await caches.keys();
        await Promise.all(keys.map((key) => caches.delete(key)));
      }
    } catch (_) {}
    const streamUrl = normalizeStreamUrl($('mjpegUrl').value || defaultMjpegUrl());
    const absUrl = new URL(streamUrl, window.location.href);
    absUrl.searchParams.set('_cb', String(Date.now()));
    const cacheBusted = `${absUrl.pathname}${absUrl.search}`;
    $('mjpegUrl').value = cacheBusted;
    saveSettings();
    loadMjpeg(cacheBusted);
    $('streamState').textContent = 'cache reset done';
    await postOpsEvent('ui_cache_reset', { stream: cacheBusted });
  }

  function setStreamStatus(next) {
    if (streamStatus !== next && next !== 'LIVE') {
      if (streamStatus === 'LIVE') {
        streamLostSince = Date.now();
        streamRestoredAt = 0;
        postOpsEvent('video_lost', { status: next });
      }
    }
    if (streamStatus !== next && next === 'LIVE') {
      streamRestoredAt = Date.now();
      if (streamLostHard) autoUnlockPending = true;
      postOpsEvent('video_restored', { lost_for_ms: Math.max(0, streamRestoredAt - streamLostSince) });
    }
    streamStatus = next;
    const chip = $('streamStateChip');
    chip.textContent = streamStatus;
    chip.className = `stream-chip ${streamStatus.toLowerCase()}`;
  }

  function startLostTicker() {
    if (streamLostTicker) clearInterval(streamLostTicker);
    streamLostTicker = setInterval(() => {

      if (streamStatus === 'LIVE' && streamLostHard && autoUnlockPending && streamRestoredAt > 0) {
        const stableMs = Date.now() - streamRestoredAt;
        if (stableMs >= safeRestoreSec * 1000) {
          autoUnlockPending = false;
          streamLostHard = false;
          const allowAuto = window.confirm('Stream stable >3s. Разрешить вернуть AUTO режим?');
          if (allowAuto) {
            $('controlMode').value = 'auto';
            saveSettings();
          } else {
            $('controlMode').value = 'manual';
            saveSettings();
          }
        }
      }
      if (streamStatus === 'LIVE') {
        $('streamLostFor').textContent = '0.0s';
        return;
      }
      const lostMs = Math.max(0, Date.now() - streamLostSince);
      const sec = lostMs / 1000;
      $('streamLostFor').textContent = `${sec.toFixed(1)}s`;
      if (!streamLostHard && sec >= safeLostSec) {
        streamLostHard = true;
        if ($('controlMode').value !== 'manual') {
          $('controlMode').value = 'manual';
          saveSettings();
          panicStop('stream-lost-safe-mode');
          $('streamState').textContent = 'safe mode: auto blocked';
        }
      }
    }, 100);
  }

  function manualDrive(pan, tilt, zoom) {
    if (zoomAprilTagCalibrationActive || zoomCalibInProgress) {
      pan = 0;
      tilt = 0;
      zoom = 0;
    }
    if ($('auto').checked || $('controlMode').value === 'manual') connectWs();
    if (!ws || ws.readyState !== 1) return;
    const safeLimited = applySafeModeLimits(pan, tilt, zoom);
    const limited = applyCommandLimits(safeLimited.pan, safeLimited.tilt, safeLimited.zoom);
    seq = (seq + 1) & 0xFFFF;
    sendLine(`J ${seq} ${limited.pan} ${limited.tilt}`);
    sendLine(`Z ${limited.zoom}`);

    updateZoomStateFromCommand(limited.zoom);
  }

  function clamp01(v) {
    return Math.max(0, Math.min(1, v));
  }

  function getZoomTravelSec() {
    return Math.max(2, Number($('zoomTravelSec').value || DEFAULT_ZOOM_TRAVEL_SEC));
  }

  function renderZoomState() {
    $('zoomStateValue').textContent = zoomState.toFixed(2);
  }

  function computeZoomSpeedLevelFromCmd(zoomCmdPct) {
    const absCmd = Math.abs(Number(zoomCmdPct) || 0);
    if (absCmd <= 0) return 0;
    const table = Array.isArray(zoomCalibProfile?.speedTable) ? zoomCalibProfile.speedTable : [];
    for (const row of table) {
      if (absCmd <= row.cmdAbs) return row.level;
    }
    if (table.length > 0) return table[table.length - 1].level;
    const maxAbs = Math.max(1, Number(cmdLimits.zoom) || 34);
    const step = maxAbs / 4;
    if (absCmd <= step) return 1;
    if (absCmd <= step * 2) return 2;
    if (absCmd <= step * 3) return 3;
    return 4;
  }

  function updateZoomStateFromCommand(zoomCmdPct) {
    const now = Date.now();
    const dtSec = Math.max(0, (now - zoomStateLastTs) / 1000);
    zoomStateLastTs = now;
    if (!zoomCmdPct || dtSec <= 0) return;
    const speedLevel = computeZoomSpeedLevelFromCmd(zoomCmdPct);
    const speedNorm = Math.sign(zoomCmdPct) * (speedLevel / 4);
    zoomState = clamp01(zoomState + (speedNorm * dtSec / getZoomTravelSec()));
    renderZoomState();
  }

  function applySafeModeLimits(pan, tilt, zoom) {
    if (!streamLostHard && telemetryState.linkMode === 'normal') return { pan, tilt, zoom };
    const clamp = (value, maxAbs) => Math.max(-maxAbs, Math.min(maxAbs, value));

    let panTiltLimit = 100;
    let zoomLimit = 100;
    if (telemetryState.linkMode === 'safe') {
      panTiltLimit = LINK_SAFE_MODE_PAN_TILT_LIMIT;
      zoomLimit = LINK_SAFE_MODE_ZOOM_LIMIT;
    } else if (telemetryState.linkMode === 'critical') {
      panTiltLimit = LINK_CRITICAL_PAN_TILT_LIMIT;
      zoomLimit = LINK_CRITICAL_ZOOM_LIMIT;
    }
    if (streamLostHard) {
      panTiltLimit = Math.min(panTiltLimit, SAFE_MODE_PAN_TILT_LIMIT);
      zoomLimit = Math.min(zoomLimit, SAFE_MODE_ZOOM_LIMIT);
    }
    return {
      pan: clamp(pan, panTiltLimit),
      tilt: clamp(tilt, panTiltLimit),
      zoom: clamp(zoom, zoomLimit),
    };
  }

  function applyCommandLimits(pan, tilt, zoom) {
    const clamp = (value, maxAbs) => Math.max(-maxAbs, Math.min(maxAbs, value));
    return {
      pan: clamp(pan, cmdLimits.pan),
      tilt: clamp(tilt, cmdLimits.tilt),
      zoom: clamp(zoom, cmdLimits.zoom),
    };
  }

  function bindTouchControls() {
    const map = {
      up:    { pan: 0, tilt: 35, zoom: 0 },
      down:  { pan: 0, tilt: -35, zoom: 0 },
      left:  { pan: -35, tilt: 0, zoom: 0 },
      right: { pan: 35, tilt: 0, zoom: 0 },
      zin:   { pan: 0, tilt: 0, zoom: -45 },
      zout:  { pan: 0, tilt: 0, zoom: 45 },
      stop:  { pan: 0, tilt: 0, zoom: 0 },
    };
    const onStart = (btn) => {
      const cmd = btn.dataset.cmd;
      if (!map[cmd]) return;

      if ($('controlMode').value === 'ptz' && !['zin', 'zout', 'stop'].includes(cmd)) {
        return;
      }

      touchState = map[cmd];
      btn.classList.add('active');

      if ($('controlMode').value === 'ptz') {
        sendZoomOnly(touchState.zoom);
        return;
      }

      manualDrive(touchState.pan, touchState.tilt, touchState.zoom);
    };
    const onEnd = (btn) => {
      btn.classList.remove('active');
      touchState = { pan: 0, tilt: 0, zoom: 0 };

      if ($('controlMode').value === 'ptz') {
        sendZoomOnly(0);
        return;
      }

      manualDrive(0, 0, 0);
    };
    document.querySelectorAll('#touchControls .touch-btn').forEach((btn) => {
      btn.addEventListener('pointerdown', () => onStart(btn));
      btn.addEventListener('pointerup', () => onEnd(btn));
      btn.addEventListener('pointercancel', () => onEnd(btn));
      btn.addEventListener('pointerleave', () => onEnd(btn));
    });
  }

  bindTouchControls();
  window.addEventListener('pointerup', () => {
    touchState = { pan: 0, tilt: 0, zoom: 0 };
    manualDrive(0, 0, 0);
  });
  window.addEventListener('blur', () => {
    keyboardState = { up: false, down: false, left: false, right: false, zin: false, zout: false };
    manualDrive(0, 0, 0);
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) panicStop('hidden-tab');
    if (!document.hidden) applyLandscapeLock();
  });
  window.addEventListener('beforeunload', () => panicStop('unload'));

  function shouldIgnoreKeyboardEvent(e) {
    const tag = e.target?.tagName;
    if (!tag) return false;
    const editableTags = ['INPUT', 'TEXTAREA', 'SELECT'];
    if (editableTags.includes(tag)) return true;
    return Boolean(e.target?.isContentEditable);
  }

  function withWsReady(fn) {
    if (ws && ws.readyState === 1) {
      fn();
      return;
    }
    connectWs();
    let done = false;
    const tryRun = () => {
      if (done) return;
      if (ws && ws.readyState === 1) {
        done = true;
        fn();
      }
    };
    setTimeout(tryRun, 80);
    setTimeout(tryRun, 250);
  }

  function sendZoomOnly(zoom) {
    if (zoomAprilTagCalibrationActive || zoomCalibInProgress) zoom = 0;
    const safeLimited = applySafeModeLimits(0, 0, zoom);
    const limited = applyCommandLimits(0, 0, safeLimited.zoom);

    withWsReady(() => {
      sendLine(`Z ${limited.zoom}`);
      updateZoomStateFromCommand(limited.zoom);
      $('zoomStick').textContent = `zoom=${limited.zoom} (PTZ zoom-only)`;
    });
  }

  function applyKeyboardDrive() {
    const pan = (keyboardState.right ? 35 : 0) + (keyboardState.left ? -35 : 0);
    let tilt = (keyboardState.up ? -35 : 0) + (keyboardState.down ? 35 : 0);
    if (invertTiltAxis) tilt = -tilt;
    const zoom = (keyboardState.zin ? -45 : 0) + (keyboardState.zout ? 45 : 0);

    if ($('controlMode').value === 'ptz') {
      // In PTZ mode server autopilot owns pan/tilt.
      // Keyboard Q/A is still allowed for optical zoom, but must not send J 0 0.
      sendZoomOnly(zoom);
      return;
    }

    manualDrive(pan, tilt, zoom);
  }

  window.addEventListener('keydown', (e) => {

    if (e.repeat) return;
    if (e.key === 'Escape') {
      panicStop('esc');
      return;
    }
    if (shouldIgnoreKeyboardEvent(e)) return;
    const key = e.key.toLowerCase();
    const map = {
      arrowup: 'up',
      arrowdown: 'down',
      arrowleft: 'left',
      arrowright: 'right',
      q: 'zin',
      a: 'zout',
    };
    const action = map[key];
    if (!action) return;
    e.preventDefault();
    keyboardState[action] = true;
    applyKeyboardDrive();
  });

  window.addEventListener('keyup', (e) => {
    if (shouldIgnoreKeyboardEvent(e)) return;
    const key = e.key.toLowerCase();
    const map = {
      arrowup: 'up',
      arrowdown: 'down',
      arrowleft: 'left',
      arrowright: 'right',
      q: 'zin',
      a: 'zout',
    };
    const action = map[key];
    if (!action) return;
    e.preventDefault();
    keyboardState[action] = false;
    applyKeyboardDrive();
  });

</script>



