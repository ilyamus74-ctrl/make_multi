  function applyDetectorPreset(kind) {
    if (!detectorClassNames.length) return;
    const pickByName = name => detectorClassNames.findIndex(v => v.toLowerCase() === name);
    if (kind === 'person') {
      const p = pickByName('person');
      if (p >= 0) syncDetectorClasses([p]);
      return;
    }
    if (kind === 'vehicle') {
      const ids = ['car', 'truck', 'bus', 'motorbike', 'motorcycle', 'bicycle']
        .map(pickByName)
        .filter(v => v >= 0);
      if (ids.length) syncDetectorClasses(ids);
      return;
    }
    syncDetectorClasses(detectorClassNames.map((_, idx) => idx));
  }

