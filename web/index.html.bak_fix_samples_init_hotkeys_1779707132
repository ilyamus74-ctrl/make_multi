      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = 'no classes';
      primary.appendChild(opt);
      primary.disabled = true;
      return;
    }
    detectorClassNames.forEach((name, idx) => {
      const opt = document.createElement('option');
      opt.value = String(idx);
      opt.textContent = `${idx}:${name}`;
      primary.appendChild(opt);
      const wrap = document.createElement('label');
      wrap.style.display = 'inline-flex';
      wrap.style.gap = '3px';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.value = String(idx);
      cb.checked = detectorSelectedClasses.includes(idx);
      cb.onchange = async () => {
        const now = detectorSelectedClasses.slice();
        if (cb.checked && !now.includes(idx)) now.push(idx);
        if (!cb.checked) now.splice(now.indexOf(idx), 1);
        await syncDetectorClasses(now);
      };
      wrap.appendChild(cb);
      const txt = document.createElement('span');
      txt.textContent = name;
      wrap.appendChild(txt);
      allowed.appendChild(wrap);
    });
    primary.disabled = false;
    if (detectorSelectedClasses.length) primary.value = String(detectorSelectedClasses[0]);
    else primary.value = '0';
  }

  async function refreshDetectorClasses(source, selectedHint = null) {
    detectorClassSource = String(source || detectorClassSource || 'coco.names');
    $('detectorClassesSource').value = detectorClassSource;
    try {
      const res = await fetch(`/api/detector/classes?source=${encodeURIComponent(detectorClassSource)}`, { cache: 'no-store' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      detectorClassNames = Array.isArray(data.classes) ? data.classes.map(v => String(v || '')).filter(Boolean) : [];
      detectorSelectedClasses = clampClassIndexList(selectedHint == null ? detectorSelectedClasses : selectedHint);
      renderDetectorClassControls();
    } catch (_) {
      detectorClassNames = [];
      detectorSelectedClasses = [];
      renderDetectorClassControls();
    }
  }

  async function syncDetectorClasses(classIds) {
    const payloadClasses = clampClassIndexList(classIds);
    try {
      await fetch('/api/detector/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ selected_classes: payloadClasses }),
      });
    } catch (_) {}
    detectorSelectedClasses = payloadClasses;
    renderDetectorClassControls();
