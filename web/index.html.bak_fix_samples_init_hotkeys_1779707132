  function sendManualTick() {
    if (zoomAprilTagCalibrationActive || zoomCalibInProgress) {
      return;
    }
    pidState.targetText = 'manual mode';
    $('pidTarget').textContent = pidState.targetText;
    $('pidCmd').textContent = '0,0';
    pidState.intX = 0;
    pidState.intY = 0;
    pidState.prevErrX = 0;
    pidState.prevErrY = 0;
    pidState.panActive = false;
    finishReacquireSession('manual_override');
    const pads = navigator.getGamepads ? navigator.getGamepads() : [];
    const gp = pads && pads[0];
    if (!gp) {
      $('gp').textContent = 'NOT FOUND (нажми кнопку на геймпаде)';
      $('gp').className = 'bad';
      return;
    }
    $('gp').textContent = gp.id; $('gp').className = 'ok';

    const dz = Math.max(0, Math.min(30, parseInt($('dz').value || '5', 10)));

    let pan  = gp.axes[AXIS_PAN]  || 0; if (INV_PAN)  pan  = -pan;
    let tilt = gp.axes[AXIS_TILT] || 0; if (invertTiltAxis) tilt = -tilt;
    let zoom = gp.axes[AXIS_ZOOM] || 0; if (INV_ZOOM) zoom = -zoom;

    const panPct  = applyDead(Math.max(-100, Math.min(100, Math.round(pan  * 100))), dz);
    const tiltPct = applyDead(Math.max(-100, Math.min(100, Math.round(tilt * 100))), dz);
    const zoomPct = applyDead(Math.max(-100, Math.min(100, Math.round(zoom * 100))), dz);

    $('axes').textContent     = `pan=${panPct} tilt=${tiltPct}  raw=[${gp.axes.map(v=>v.toFixed(2)).join(', ')}]`;
    $('zoomStick').textContent = `zoom=${zoomPct}`;

    if ($('auto').checked || $('controlMode').value === 'manual') connectWs();
    if (!ws || ws.readyState !== 1) return;

    let cmdPan = panPct;
    let cmdTilt = tiltPct;
    const now = Date.now();
    const micro = getMicrostepVector(gp);
    if (micro.active && (now - microstepLastSentAt >= MICROSTEP_REPEAT_MS)) {
      cmdPan = micro.pan;
      cmdTilt = micro.tilt;
      $('msBtn').textContent = `${micro.name} (${cmdPan},${cmdTilt})`;
      microstepLastSentAt = now;
    } else if (!micro.active) {
      $('msBtn').textContent = '-';
    }
    const safeLimited = applySafeModeLimits(cmdPan, cmdTilt, zoomPct);
    const limited = applyCommandLimits(safeLimited.pan, safeLimited.tilt, safeLimited.zoom);
    seq = (seq + 1) & 0xFFFF;
