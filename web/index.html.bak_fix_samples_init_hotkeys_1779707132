  function sendAssistTick() {
    if ($('auto').checked || $('controlMode').value === 'manual') connectWs();
    if (!ws || ws.readyState !== 1) return;
    fetch('/api/detections', { cache: 'no-store' })
      .then(r => r.ok ? r.json() : null)
      .then(det => {
        if (!det) return;
        ingestDetections(det);
        const cmd = computePidCommand(det);
        if (!cmd) return;
        const scale = 0.45;
        const assistPan = Math.round(cmd.pan * scale);
        const assistTilt = Math.round(cmd.tilt * scale);
        const limited = applySafeModeLimits(assistPan, assistTilt, 0);
        seq = (seq + 1) & 0xFFFF;
        sendLine(`J ${seq} ${limited.pan} ${limited.tilt}`);
        $('axes').textContent = `assist ex=${cmd.errX.toFixed(3)} ey=${cmd.errY.toFixed(3)} fused=${cmd.fused.toFixed(2)} mode=${cmd.mode}`;
        $('zoomStick').textContent = 'zoom=0 (ASSIST)';
        $('pidTarget').textContent = pidState.targetText;
        $('pidCmd').textContent = `${limited.pan},${limited.tilt}`;
      })
      .catch(() => {});
  }

  function sendAutoTick() {
    if ($('auto').checked || $('controlMode').value === 'manual') connectWs();
    if (!ws || ws.readyState !== 1) return;
    fetch('/api/detections', { cache: 'no-store' })
      .then(r => r.ok ? r.json() : null)
      .then(det => {
        if (!det) return;
        ingestDetections(det);
        const cmd = computePidCommand(det);
        if (!cmd) return;
        const autoCmd = maybeApplyReacquire(cmd);
        const limited = applySafeModeLimits(autoCmd.pan, autoCmd.tilt, 0);
        seq = (seq + 1) & 0xFFFF;
        sendLine(`J ${seq} ${limited.pan} ${limited.tilt}`);
        $('axes').textContent = `pid ex=${cmd.errX.toFixed(3)} ey=${cmd.errY.toFixed(3)} fused=${cmd.fused.toFixed(2)} mode=${autoCmd.mode}`;
        $('zoomStick').textContent = 'zoom=0 (PID)';
        $('pidTarget').textContent = pidState.targetText;
        $('pidCmd').textContent = `${limited.pan},${limited.tilt}`;
