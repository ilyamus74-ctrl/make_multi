  async function runAprilTagZoomCalibrationFromUi() {
    const prevMode = $('controlMode')?.value || 'manual';

    try {
      $('zoomAprilTagCalibStatus').textContent = 'switching to PTZ safe mode...';

      if ($('controlMode') && $('controlMode').value !== 'ptz') {
        ptzLog('ZOOM CALIB SAFE MODE', {
          from: prevMode,
          to: 'ptz',
          reason: 'april_tag_zoom_calibration'
        });
        setControlMode('ptz');
        await sleepMs(200);
      }

      touchState = { pan: 0, tilt: 0, zoom: 0 };
      keyboardState = { up: false, down: false, left: false, right: false, zin: false, zout: false };

      panicStop('zoom-apriltag-calibration-start');

      zoomAprilTagCalibrationActive = true;
      zoomCalibInProgress = true;
      syncControlModeUi();

      $('zoomRunAprilTagCalibBtn').disabled = true;
      $('zoomRunAprilTagCalibBtn').classList.add('active');

      $('zoomAprilTagCalibStatus').textContent = 'saving settings...';
      await saveZoomCalibSettingsFromUi();

      const payload = readZoomCalibSettingsFromUi();
      payload.mode = "apriltag_zoom_table";

      $('zoomAprilTagCalibStatus').textContent = 'starting calibration...';

      const res = await fetch('/api/zoom_calibration', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      ptzLog('ZOOM APRILTAG CALIB', data);

      if (!data?.started) {
        $('zoomAprilTagCalibStatus').textContent = 'busy/not started';
        return;
      }
      $('zoomAprilTagCalibStatus').textContent = 'calibration running...';

      for (let i = 0; i < 180; i++) {
        await sleepMs(1000);
        await refreshZoomCalibrationProfile();

        const status = $('zoomCalibStatus').textContent || 'running';
        $('zoomAprilTagCalibStatus').textContent = status;

        if (!zoomCalibInProgress) break;
      }

      await saveZoomCalibSettingsFromUi();

    } catch (e) {
      $('zoomAprilTagCalibStatus').textContent = `error: ${String(e.message || e)}`;
      ptzLog('ZOOM APRILTAG CALIB error', { error: String(e.message || e) });
    } finally {
      zoomAprilTagCalibrationActive = false;
      zoomCalibInProgress = false;

      $('zoomRunAprilTagCalibBtn').disabled = false;
      $('zoomRunAprilTagCalibBtn').classList.remove('active');

      touchState = { pan: 0, tilt: 0, zoom: 0 };
      keyboardState = { up: false, down: false, left: false, right: false, zin: false, zout: false };

      panicStop('zoom-apriltag-calibration-end');
      syncControlModeUi();
    }
  }

