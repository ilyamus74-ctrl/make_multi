  async function postOpsEvent(type, details = {}) {
    const payload = {
      type,
      ts_ms: Date.now(),
      details,
    };
    try {
      await fetch('/api/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
    } catch (_) {}
  }

  function handleRx(s) {
    const lines = s.split(/\r?\n/).map(x => x.trim()).filter(Boolean);
    for (const line of lines) {
      if (line.startsWith('A ')) {
        $('ack').textContent = line;
      }
    }
  }

  function applyDead(pct, dz) { return Math.abs(pct) <= dz ? 0 : pct; }
  function clamp(v, mn, mx) { return Math.max(mn, Math.min(mx, v)); }
  function limitAccel(next, prev, maxDelta) {
    return clamp(next, prev - maxDelta, prev + maxDelta);
  }

  function applyZeroHysteresis(cmd, active, holdThreshold, releaseThreshold) {
    const absCmd = Math.abs(cmd);
    if (active) {
      if (absCmd <= holdThreshold) {
        return { cmd: 0, active: false };
      }
      return { cmd, active: true };
    }
    if (absCmd >= releaseThreshold) {
      return { cmd, active: true };
    }
    return { cmd: 0, active: false };
  }
  function readPidParams() {
    const kp = Number($('pidKp').value || 32);
    const ki = Number($('pidKi').value || 0);
    const kd = Number($('pidKd').value || 18);
    const deadzonePct = clamp(Number($('pidDeadzone').value || 4), 0, 30);
    const maxSpeed = clamp(Math.round(Number($('pidMaxSpeed').value || 40)), 5, 100);
    const maxAccel = clamp(Math.round(Number($('pidMaxAccel').value || 8)), 1, 40);
    const panHold = clamp(Math.round(Number($('pidPanHold').value || 2)), 0, 30);
    const panRelease = clamp(Math.round(Number($('pidPanRelease').value || 5)), panHold + 1, 50);
    return {
      kp: Number.isFinite(kp) ? kp : 32,
      ki: Number.isFinite(ki) ? ki : 0,
      kd: Number.isFinite(kd) ? kd : 18,
      deadzonePct,
      maxSpeed,
      maxAccel,
      panHold,
      panRelease,
    };
  }
  function readReacquireParams() {
    return {
      panStep: clamp(Math.round(Number($('reacquirePanStep').value || 18)), 2, 60),
      tiltStep: clamp(Math.round(Number($('reacquireTiltStep').value || 8)), 0, 40),
      panCadence: clamp(Math.round(Number($('reacquirePanCadence').value || 8)), 2, 60),
      tiltCadence: clamp(Math.round(Number($('reacquireTiltCadence').value || 16)), 2, 120),
      holdMs: clamp(Math.round(Number($('reacquireHoldMs').value || 700)), 200, 3000),
      maxLostSec: clamp(Number($('reacquireMaxLostSec').value || 8), 2, 30),
