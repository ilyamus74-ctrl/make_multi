  function finishReacquireSession(result) {
    if (!reacquireState.active) return;
    const lostMs = Math.max(0, Date.now() - reacquireState.lostSince);
    postOpsEvent('track_reacquire_end', {
      result,
      reason: reacquireState.reason || 'unknown',
      lost_ms: Math.round(lostMs),
