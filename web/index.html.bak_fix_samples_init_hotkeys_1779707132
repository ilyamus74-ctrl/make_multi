  function getMicrostepVector(gp) {
    const order = [BTN_X, BTN_A, BTN_B, BTN_Y];
    const map = swapMicroButtons
      ? { [BTN_X]: BTN_X, [BTN_A]: BTN_Y, [BTN_B]: BTN_B, [BTN_Y]: BTN_A }
      : { [BTN_X]: BTN_X, [BTN_A]: BTN_A, [BTN_B]: BTN_B, [BTN_Y]: BTN_Y };
    for (const physicalBtn of order) {
      if (gp.buttons[physicalBtn] && gp.buttons[physicalBtn].pressed) {
        const logicalBtn = map[physicalBtn];
        if (logicalBtn === BTN_X) return { active: true, pan: -MICROSTEP_VAL, tilt: 0, name: 'X' };
        if (logicalBtn === BTN_B) return { active: true, pan: +MICROSTEP_VAL, tilt: 0, name: 'B' };
        if (logicalBtn === BTN_A) {
          const tilt = invertTiltAxis ? -MICROSTEP_VAL : MICROSTEP_VAL;
          return { active: true, pan: 0, tilt, name: 'A' };
        }
        if (logicalBtn === BTN_Y) {
          const tilt = invertTiltAxis ? MICROSTEP_VAL : -MICROSTEP_VAL;
          return { active: true, pan: 0, tilt, name: 'Y' };
        }
      }
     }
    return { active: false, pan: 0, tilt: 0, name: '-' };
  }

