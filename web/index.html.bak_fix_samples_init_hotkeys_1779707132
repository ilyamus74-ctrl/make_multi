  async function ptzTuneLoadPointForCurrentStep() {
    const profile = await apiGetJson(`${autopilotBaseUrl()}/api/autopilot/speed_profile`);
    const points = Array.isArray(profile.points) ? profile.points : [];
    const step = Number(ptzTuneStep || 0);
    let point = points.find(p => Number(p.step) === step);

    if (!point) {
      const z = await apiGetJson('/api/zoom/state');
      const ratio = Number(z.zoom_ratio ?? 0);
      point = points
        .slice()
        .sort((a, b) => Math.abs(Number(a.zoom_ratio ?? 0) - ratio) - Math.abs(Number(b.zoom_ratio ?? 0) - ratio))[0];
    }

    if (!point) {
      ptzLog('PTZ SPEED LOAD POINT', { ok: false, step, error: 'no_saved_points' });
      return { ok: false, error: 'no_saved_points' };
    }

    fillPtzTuneFieldsFromConfig(point);
    const res = await apiPostJson(`${autopilotBaseUrl()}/api/autopilot/config`, {
      kp: Number(point.kp ?? 0),
      ki: Number(point.ki ?? 0),
      kd: Number(point.kd ?? 0),
      deadzone: Number(point.deadzone ?? 0),
      max_pan: Number(point.max_pan ?? 0),
      max_tilt: Number(point.max_tilt ?? 0),
      max_accel: Number(point.max_accel ?? 0),
      min_pan: Number(point.min_pan ?? 0),
      min_tilt: Number(point.min_tilt ?? 0)
    });

    ptzLog('PTZ SPEED LOAD POINT', { ok: true, step, point, res });
    await refreshPtzTelemetry();
    return { ok: true, point, res };
  }

