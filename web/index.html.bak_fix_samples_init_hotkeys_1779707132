    tiltCmd = limitAccel(tiltCmd, pidState.lastCmdTilt, params.maxAccel);
    const panH = applyZeroHysteresis(panCmd, pidState.panActive, params.panHold, params.panRelease);
    panCmd = panH.cmd;
