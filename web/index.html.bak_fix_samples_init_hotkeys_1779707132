  ptzTuneCurrentSample = Number(sampleIdx);

  const res = await apiPostJson('/api/zoom/state', {
    zoom_ratio: Number(target.zoom_ratio || 0),
    zoom_confidence: 1,
    zoom_source: source || `ptz_tune_sample_${sampleIdx}`,
    zoom_sample_idx: Number(sampleIdx)
  });

