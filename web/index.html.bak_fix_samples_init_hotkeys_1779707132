  async function refreshCommandLimits() {
    try {
      const res = await fetch('/api/command_limits', { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      const clampLimit = (value, fallback) => {
        const num = Number(value);
        if (!Number.isFinite(num)) return fallback;
        return Math.max(0, Math.min(100, Math.round(num)));
      };
      cmdLimits = {
        pan: clampLimit(data?.cmd_max_pan, cmdLimits.pan),
        tilt: clampLimit(data?.cmd_max_tilt, cmdLimits.tilt),
        zoom: clampLimit(data?.cmd_max_zoom, cmdLimits.zoom),
      };
    } catch (_) {}
  }

  async function refreshZoomCalibrationProfile() {
    try {
      const res = await fetch('/api/zoom_calibration', { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      const table = Array.isArray(data?.speed_table) ? data.speed_table : [];
      zoomCalibProfile = {
        source: String(data?.source || 'server'),
        cmdMaxZoom: Number(data?.cmd_max_zoom || cmdLimits.zoom || 34),
        holdMs: Number(data?.hold_ms || 4000),
        measuredFullTravelSec: Number(data?.measured_full_travel_sec || 0),
        speedTable: table
          .map((row) => ({
            level: Number(row?.level || 0),
            cmdAbs: Number(row?.cmd_abs || 0),
            ratioPerSec: Number(row?.ratio_per_sec || 0),
          }))
          .filter((row) => row.level >= 1 && row.level <= 4 && row.cmdAbs > 0)
          .sort((a, b) => a.cmdAbs - b.cmdAbs),
      };
      const inProgress = Boolean(data?.in_progress);
      zoomCalibInProgress = inProgress;
      const lastStatus = String(data?.last_status || 'idle');
      const lastMessage = String(data?.last_message || '');
      $('zoomCalibStatus').textContent = inProgress
        ? 'running...'
        : `${lastStatus}${lastMessage ? `:${lastMessage}` : ''}`;
      $('zoomRunCalibrationBtn').disabled = inProgress;
      if (Number.isFinite(zoomCalibProfile.measuredFullTravelSec) && zoomCalibProfile.measuredFullTravelSec > 0) {
        $('zoomTravelSec').value = Math.max(2, zoomCalibProfile.measuredFullTravelSec).toFixed(1);
      }
    } catch (_) {}
  }

