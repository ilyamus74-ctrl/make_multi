  let manualBackendActive = false;
  let manualStopInFlight = false;
  let manualLastStopTs = 0;
  const MANUAL_STOP_MIN_INTERVAL_MS = 150;

  let lastManualDriveLogAt = 0;
  let lastManualDriveLogKey = '';

  function maybeLogManualDrive(res, source) {
    const now = Date.now();
    const key = `${res?.final_pan},${res?.final_tilt},${res?.invert_pan},${res?.invert_tilt},${res?.profile_idx}`;
    if (key !== lastManualDriveLogKey || now - lastManualDriveLogAt > 500) {
      ptzLog('MANUAL DRIVE BACKEND', { ...res, source });
      lastManualDriveLogAt = now;
      lastManualDriveLogKey = key;
    }
