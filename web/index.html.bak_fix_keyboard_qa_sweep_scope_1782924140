  function wsUrl() {
    const proto = location.protocol === 'https:' ? 'wss' : 'ws';
    const port  = parseInt($('port').value || '8765', 10);
    let path    = ($('path').value || '/ws').trim();
    if (!path.startsWith('/')) path = '/' + path;
    return `${proto}://${location.hostname}:${port}${path}`;
  }
  function setWsState(ok) {
    $('ws').textContent = ok ? 'CONNECTED' : 'DISCONNECTED';
    $('ws').className   = ok ? 'ok' : 'bad';
  }
  function connectWs() {
    if (ws && ws.readyState < 2) return;
    if (wsReconnectTimer) {
      clearTimeout(wsReconnectTimer);
      wsReconnectTimer = null;
    }
    const url = wsUrl();
    $('wsurl').textContent = url;
    try { ws = new WebSocket(url); } catch(e) { setWsState(false); return; }
    ws.onopen    = () => setWsState(true);
    ws.onclose   = () => {
      setWsState(false);
      if ($('auto').checked) {
        wsReconnectTimer = setTimeout(connectWs, 500);
      }
    };
    ws.onerror   = () => {};
    ws.onmessage = e => handleRx(String(e.data || ''));
  }
  function disconnectWs() {
    if (wsReconnectTimer) {
      clearTimeout(wsReconnectTimer);
      wsReconnectTimer = null;
    }
    if (ws) try { ws.close(); } catch(e) {}
    ws = null; setWsState(false);
  }
  function sendLine(line) {
    if (!ws || ws.readyState !== 1) return;
    ws.send(line + "\n");
    $('tx').textContent = line;
  }

  function autopilotBaseUrl() {
    return `${location.protocol}//${location.hostname}:8090`;
  }

  async function apiGetJson(url) {
    const r = await fetch(url, { cache: 'no-store' });
    if (!r.ok) throw new Error(`${r.status} ${url}`);
    return await r.json();
  }

  async function apiPostJson(url, payload = {}) {
