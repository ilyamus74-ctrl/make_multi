  function syncOperatorModelSelect(models, currentModel) {
    const select = $('operatorModelSelect');
    if (!select) return;

    select.innerHTML = '';

    const normalizedModels = Array.isArray(models)
      ? models.map(v => String(v || '')).filter(Boolean)
      : [];

    if (!normalizedModels.length && currentModel) {
      normalizedModels.push(String(currentModel));
    }

    if (!normalizedModels.length) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = 'no models';
      select.appendChild(opt);
      select.disabled = true;
      $('operatorModelState').textContent = 'model: unavailable';
      updateOperatorMenuSummaries();
      return;
    }

    normalizedModels.forEach(model => {
      const opt = document.createElement('option');
      opt.value = model;
      opt.textContent = model;
      select.appendChild(opt);
    });

    select.disabled = false;

    if (currentModel && normalizedModels.includes(currentModel)) {
      select.value = currentModel;
    } else {
      select.value = normalizedModels[0];
    }

    $('operatorModelState').textContent = `model: ${select.value}`;
    updateOperatorMenuSummaries();
  }

