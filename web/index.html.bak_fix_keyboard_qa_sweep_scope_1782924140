    tiltNorm = Math.max(-1, Math.min(1, Number(tiltNorm || 0)));

    if (Math.abs(panNorm) < 0.001 && Math.abs(tiltNorm) < 0.001) {
      return manualInputStop(source);
    }

    return backendManualDrive(panNorm, tiltNorm, source, holdMs);
