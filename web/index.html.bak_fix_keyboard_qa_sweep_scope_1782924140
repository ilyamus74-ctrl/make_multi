  async function backendManualStop(source = 'web') {
    const now = Date.now();

    if (!manualBackendActive) {
      return { ok: true, skipped: true, reason: 'manual_not_active' };
    }

    if (manualStopInFlight || now - manualLastStopTs < MANUAL_STOP_MIN_INTERVAL_MS) {
      return { ok: true, skipped: true, reason: 'stop_debounce' };
    }

    manualStopInFlight = true;
    manualLastStopTs = now;
    try {
      const res = await apiPostJson(`${autopilotBaseUrl()}/api/control/stop`, { source });
      manualBackendActive = false;
      ptzLog('MANUAL STOP BACKEND', res);
      return res;
    } finally {
      manualStopInFlight = false;
    }
  }

  async function manualInputDrive(panNorm, tiltNorm, source = 'manual_ui', holdMs = 250) {
