  function computePidCommand(det) {
    const frameId = Number(det.frameId || 0);
    if (frameId <= pidState.lastFrameId) return null;
    pidState.lastFrameId = frameId;

    const width = Number(det.width || 0);
    const height = Number(det.height || 0);
    const items = Array.isArray(det.items) ? det.items : [];
    if (!width || !height || items.length === 0) {
      pidState.targetText = 'no target';
      pidState.panActive = false;
      return { pan: 0, tilt: 0, errX: 0, errY: 0, fused: 0, mode: 'lost' };
    }
    const fused = Number((det.confidence && det.confidence.fused) || 0);
    const wantedClass = 'any'; // backend selected_classes already filters detections
    const filtered = wantedClass === 'any'
      ? items
      : items.filter(item => String(item.cls || '').toLowerCase() === wantedClass);
    const candidates = filtered.length > 0 ? filtered : items;
const selectedCandidate = selectedTargetId == null
  ? null
  : candidates.find(item => Number(item.id) === selectedTargetId);

if (selectedTargetId != null && !selectedCandidate) {
  pidState.targetText = `selected id=${selectedTargetId} lost`;
  pidState.intX = 0;
  pidState.intY = 0;
  pidState.panActive = false;
  pidState.lastPidTs = 0;
  return { pan: 0, tilt: 0, errX: 0, errY: 0, fused: 0, mode: 'lost' };
}

const target = selectedCandidate || [...candidates].sort((a, b) => Number(b.prop || 0) - Number(a.prop || 0))[0];
    if (!target) {
