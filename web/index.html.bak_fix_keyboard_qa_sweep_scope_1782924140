  function defaultSpeedPointForZoomMasterPoint(p) {
    const z = Math.max(0, Math.min(1, Number(p.zoom_ratio || 0)));
    const lerp = (a, b) => a + (b - a) * z;
    const round = (v) => Math.round(v);
    return {
      profile_idx: Number(p.profile_idx ?? p.step ?? 0),
      step: Number(p.profile_idx ?? p.step ?? 0),
      zoom_ratio: z,
      focal_px: Number(p.focal_px || 0),
      kp: lerp(28, 10),
      kd: lerp(2, 1),
      deadzone: lerp(0.05, 0.12),
      max_pan: round(lerp(35, 10)),
      max_tilt: round(lerp(28, 10)),
      max_accel: round(lerp(8, 2)),
      min_pan: round(lerp(3, 8)),
      min_tilt: round(lerp(3, 8)),
      ptz_curve: lerp(0.65, 0.95),
      ptz_lead_ms: round(lerp(150, 80)),
      nudge_pan: round(lerp(12, 10)),
      nudge_tilt: round(lerp(12, 10)),
      j_pulse_ms: round(lerp(50, 20)),
