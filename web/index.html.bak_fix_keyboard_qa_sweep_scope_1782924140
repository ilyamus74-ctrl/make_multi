<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>PanTilt Realtime</title>
  <style>
    :root{
      --controls-bg: rgba(13, 13, 13, 0.72);
      --controls-border: rgba(255,255,255,0.14);
      --controls-bottom-offset: 46px;
    }
    html, body{width:100%;height:100%;overflow:hidden}
    body{font-family:system-ui,Arial;margin:0;padding:0;background:#000;color:#fff}
    .layout{display:flex;flex-direction:column;gap:0;height:100dvh}
    .panel{border:1px solid #ccc;border-radius:8px;padding:12px;background:#fff}
    .panel h4{margin:0 0 10px 0;font-size:14px;color:#555}
    .video-panel{
      position:relative;
      flex:1;
      border:0;
      border-radius:0;
      padding:0;
      overflow:hidden;
      background:#000;
    }
    .stream-wrap{background:#111;overflow:hidden;height:100%;display:flex;align-items:center;justify-content:center}
    .stream-wrap iframe,
    .stream-wrap img{width:100%;height:100%;display:block;object-fit:contain;background:#000;border:0}
    .stream-wrap.cover iframe,
    .stream-wrap.cover img{object-fit:cover}
    .det-overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:auto;z-index:3}
    .apriltag-overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3;display:none}
body.zoom-calib-active .apriltag-overlay{display:block}
    .hidden{display:none !important}
    .stream-settings{display:flex;align-items:center;gap:8px;flex-wrap:wrap;position:absolute;top:10px;left:10px;right:10px;z-index:4;background:var(--controls-bg);border:1px solid var(--controls-border);border-radius:10px;padding:8px}
    .controls-panel{order:2;position:absolute;left:10px;right:10px;bottom:10px;z-index:4;background:var(--controls-bg);border:1px solid var(--controls-border);backdrop-filter:blur(4px);max-height:42dvh;overflow:auto}
    .controls-spoiler{border-radius:8px}
    .controls-spoiler summary{
      cursor:pointer;
      font-weight:600;
      padding:4px 2px;
      user-select:none;
    }
    .controls-spoiler[open] summary{margin-bottom:6px}
    .hint{font-size:12px;color:#666;margin-top:8px}
    .row{margin:8px 0}
    .operator-menu {
      width: 100%;
      margin-top: 4px;
      border: 1px solid var(--controls-border);
      border-radius: 8px;
      background: rgba(0,0,0,.28);
    }
    .operator-menu > summary {
      cursor: pointer;
      padding: 5px 8px;
      font-weight: 700;
      user-select: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .operator-menu .menu-body {
      padding: 6px 8px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    .operator-menu[open] > summary { background: rgba(255,255,255,.08); }
    .operator-menu code,
    .operator-menu input,
    .operator-menu select,
    .operator-menu button { font-size: 12px; }
    .operator-menu.compact .menu-body {
      max-height: 160px;
      overflow: auto;
    }
    .ok{color:#0a0}.bad{color:#a00}.warn{color:#a60}
    code{background:#eee;padding:2px 6px;border-radius:6px}
    input{width:90px}
    input, select, textarea{color:#000;background:#fff}
    .floating-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
    .stream-chip{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:2px 8px;
      border-radius:999px;
      border:1px solid var(--controls-border);
      font-weight:700;
      letter-spacing:.2px;
    }
    .stream-chip.live{background:rgba(20,140,80,0.28);color:#b8ffd9}
    .stream-chip.reconnecting{background:rgba(180,140,30,0.28);color:#ffe4a8}
    .stream-chip.lost{background:rgba(180,40,40,0.32);color:#ffd0d0}
    .stream-lost-time{font-variant-numeric:tabular-nums;min-width:52px;display:inline-block}
    .telemetry-chip{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border:1px solid var(--controls-border);border-radius:999px;font-size:12px;background:rgba(255,255,255,0.08)}
    .small-btn{
      border:1px solid var(--controls-border);
      background:rgba(255,255,255,0.12);
      color:#fff;
      border-radius:8px;
      padding:4px 8px;
      font-size:12px;
      cursor:pointer;
    }
    .gear-btn{
      width:30px;
      height:30px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:0;
      font-size:16px;
      line-height:1;
    }
    .visually-hidden{
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      white-space:nowrap;
      border:0;
    }
    .danger-btn{
      border:1px solid rgba(255,120,120,0.9);
      background:rgba(180,20,20,0.85);
      color:#fff;
      border-radius:10px;
      font-weight:700;
      padding:8px 12px;
    }
    .danger-btn.active{
      box-shadow:0 0 0 2px rgba(255,120,120,0.5) inset;
    }

    .mode-chip{display:inline-flex;gap:6px;align-items:center;padding:4px 10px;border-radius:999px;background:rgba(255,255,255,0.08);font-size:12px}
    .mode-switch{display:inline-flex;gap:6px;align-items:center}
    .mode-btn{
      opacity:0.65;
      border:1px solid rgba(255,255,255,0.25);
      background:rgba(255,255,255,0.08);
      color:#fff;
      border-radius:999px;
      padding:4px 10px;
      font-size:12px;
      cursor:pointer;
    }
    .mode-btn.active{
      opacity:1;
      background:#1565c0;
      color:#fff;
      border:2px solid #ffffff;
      box-shadow:0 0 0 2px rgba(21,101,192,0.45);
      font-weight:700;
    }
    #modePtzBtn.active,
    #ptzModePtzBtn.active{
      background:#c62828;
      color:#fff;
      border:2px solid #fff;
      box-shadow:0 0 0 2px rgba(198,40,40,0.55);
    }
    #modeManualBtn.active,
    #ptzModeManualBtn.active{
      background:#2e7d32;
      color:#fff;
      border:2px solid #fff;
      box-shadow:0 0 0 2px rgba(46,125,50,0.55);
    }
.touch-btn{
      border:1px solid var(--controls-border);
      border-radius:12px;
      background:var(--controls-bg);
      color:#fff;
      font-size:20px;
      font-weight:600;
    }
    .touch-btn:active,.touch-btn.active{background:rgba(70,130,220,0.8)}
    .touch-btn.zoom{font-size:16px}
    .touch-hidden{display:none}
.overlay-legend{
      position:absolute;
      left:10px;
      top:64px;
      z-index:5;
      background:rgba(16,18,22,0.88);
      border:1px solid var(--controls-border);
      border-radius:8px;
      padding:4px 8px;
      font-size:11px;
      line-height:1.35;
    }
    .overlay-legend code{color:#d6d9df}
    @media (max-width: 900px){
      .controls-panel{max-height:50dvh}
      .stream-settings{gap:6px}
      .stream-settings input[type=text]{width:170px !important}
    }
    .sample-row { display:flex; flex-wrap:wrap; gap:4px; align-items:center; }
.sample-btn { min-width:34px; padding:4px 7px; }
.sample-btn.active { border:2px solid #fff; font-weight:700; }
.sample-btn.saved-user { box-shadow: inset 0 -3px 0 rgba(0,255,0,.75); }
.sample-btn.interpolated { box-shadow: inset 0 -3px 0 rgba(255,230,0,.85); }
.sample-btn.clamped { box-shadow: inset 0 -3px 0 rgba(255,165,0,.9); }
.sample-btn.missing { opacity:.65; box-shadow: inset 0 -3px 0 rgba(140,140,140,.6); }

.zoom-anchor-row.active {
  outline: 2px solid rgba(80,255,120,.8);
  background: rgba(80,255,120,.12);
  border-radius: 8px;
}
#apriltagDebugImage {
  max-width: 260px;
  max-height: 160px;
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 6px;
  margin-top: 6px;
}

.class-grid {
  display:flex;
  flex-wrap:wrap;
  gap:6px 12px;
  align-items:center;
  margin:6px 0;
}
.class-check {
  font-size:12px;
  opacity:.9;
  white-space:nowrap;
  padding:3px 5px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:6px;
}
#detectionToggleBtn.detect-on {
  border-color:#3aa657;
  box-shadow:0 0 0 1px rgba(58,166,87,.4);
}
#detectionToggleBtn.detect-off {
  border-color:#c43;
  opacity:.75;
}
</style>
</head>
<body>
  <div class="layout">
    <div class="panel video-panel">
      <div class="row stream-settings">
        Stream URL: <input id="mjpegUrl" type="text" style="width:250px" value="">
        Mode: <select id="streamMode"><option value="iframe">iframe</option><option value="img">img</option></select>
        Fit: <select id="fitMode"><option value="contain">contain</option><option value="cover">cover</option></select>
        <button id="toggleLandscapeLock" class="small-btn">LANDSCAPE: OFF</button>
        <button id="loadStream">LOAD</button>
      </div>
      <div class="stream-wrap" id="streamWrap">
        <iframe id="mjpegFrame" title="MJPEG stream frame"></iframe>
        <img id="mjpegImg" class="hidden" alt="MJPEG stream" />
      </div>
      <canvas id="detOverlay" class="det-overlay"></canvas>
      <canvas id="apriltagOverlay" class="apriltag-overlay"></canvas>
      <div class="floating-row" style="position:absolute;left:10px;bottom:10px;z-index:4;background:var(--controls-bg);border:1px solid var(--controls-border);border-radius:8px;padding:6px 10px;flex-wrap:wrap;max-height:96px;overflow:auto;align-items:center;">
Stream:
        <span id="streamStateChip" class="stream-chip reconnecting">RECONNECTING</span>
        <span id="controlModeChip" class="mode-chip">MODE: MANUAL</span>
        <span class="mode-switch">
          <button id="modeManualBtn" class="mode-btn active">MANUAL</button>
          <button id="modePtzBtn" class="mode-btn">PTZ</button>
          <button id="modeAssistBtn" class="mode-btn hidden">Assist</button>
          <button id="modeAutoBtn" class="mode-btn hidden">Auto</button>
        </span>
        <span>lost:</span>
        <code id="streamLostFor" class="stream-lost-time">0.0s</code>
        <span class="telemetry-chip">RTT <code id="netRttMs">-- ms</code></span>
        <span class="telemetry-chip">JIT <code id="netJitterMs">-- ms</code></span>
        <span class="telemetry-chip">FPS <code id="streamFps">--</code></span>
        <span class="telemetry-chip">AGE <code id="detAgeMs">-- ms</code></span>
        <span class="telemetry-chip">DROP <code id="streamDrops">--</code></span>
        <span class="telemetry-chip">LOSS <code id="streamLoss">-- %</code></span>
        <span class="telemetry-chip">DETBR <code id="detBitrate">-- kbps</code></span>
        <span class="telemetry-chip">CONF <code id="trackConfidence">--</code></span>
        <span class="telemetry-chip">CFGR <code id="confConfigRev">--/--</code></span>
        <span class="telemetry-chip">REACQ <code id="reacquireChip">OFF</code></span>
        <span class="telemetry-chip">RANGE <code id="rangeEstimate">--</code></span>
        <span class="telemetry-chip">UP <code id="serverUptime">--</code></span>
        <span class="telemetry-chip">MEM <code id="serverMemRss">-- MB</code></span>
        <span class="telemetry-chip">LOAD <code id="serverLoad1">--</code></span>
        <span class="telemetry-chip">ALERT <code id="alertState">OK</code></span>
        <span class="telemetry-chip">LINK <code id="linkModeChip">NORMAL</code></span>
        <button id="retryStream" class="small-btn">Retry stream</button>
        <button id="resetCacheBtn" class="small-btn">Reset cache</button>
        <code id="streamState" style="display:none">idle</code>
      </div>
      <div class="overlay-legend">
        Boxes: <code>DET=yellow TRACK=cyan SEL=red</code>
      </div>
      <div style="position:absolute;right:10px;top:64px;z-index:5;">
        <button id="emergencyStop" class="danger-btn">EMERGENCY STOP</button>
      </div>
</div>

    <div class="panel controls-panel">

      <div class="row" id="ptzPanel">
        <b>MODE:</b>
        <button id="ptzModeManualBtn" class="small-btn">Manual</button>
        <button id="ptzModeAssistBtn" class="small-btn hidden">Assist</button>
        <button id="ptzModeAutoBtn" class="small-btn hidden">Auto</button>
        <button id="ptzModePtzBtn" class="small-btn">PTZ</button>
        <span style="opacity:.55">|</span>
        <b>PTZ:</b>
        <button id="ptzPrecheckBtn" class="small-btn">PRECHECK</button>
        <button id="ptzSelectFirstBtn" class="small-btn">SELECT FIRST</button>
        <button id="ptzStartBtn" class="small-btn">START PTZ</button>
        <button id="ptzStopBtn" class="small-btn">STOP PTZ</button>
        <code id="ptzStateLine">idle</code>
      </div>
      <details id="detectionMenu" class="operator-menu">
        <summary>DETECTION <code id="detectionMenuSummary">model / limit / fps</code></summary>
        <div class="menu-body">
          <b>MODEL:</b>
          <select id="operatorModelSelect" class="small-select"></select>
          <button id="operatorModelApplyBtn" class="small-btn">APPLY MODEL</button>
          <code id="operatorModelState">model: --</code>
          <b>LIMIT:</b>
          <select id="operatorDetectionLimit" class="small-select">
            <option value="5">weak: 5</option>
            <option value="10" selected>normal: 10</option>
            <option value="20">strong: 20</option>
          </select>
          <button id="operatorLimitApplyBtn" class="small-btn">APPLY LIMIT</button>
          <code id="operatorLimitState">limit: --</code>
          <b>DETECT FPS:</b>
          <select id="operatorDetectEvery" class="small-select">
            <option value="1">every frame</option>
            <option value="2">1/2</option>
            <option value="3" selected>1/3</option>
            <option value="5">1/5</option>
          </select>
          <button id="operatorDetectEveryApplyBtn" class="small-btn">APPLY</button>
          <code id="operatorDetectEveryState">detect: --</code>

          <b>AREA:</b>
          <select id="operatorDetectionAreaMode" class="small-select">
            <option value="full_frame" selected>FULL FRAME</option>
            <option value="roi">ROI SKY</option>
            <option value="multi_roi">MULTI ROI</option>
            <option value="tiled">TILED 2x2</option>
            <option value="hybrid">HYBRID FULL+ROI</option>
          </select>
          <button id="operatorDetectionAreaApplyBtn" class="small-btn">APPLY AREA</button>
          <code id="operatorDetectionAreaState">area: full_frame</code>

          <div class="det-row">
            <button id="detectionToggleBtn" class="small-btn">DETECTION: --</button>
            <code id="detectionEnabledState">detect: --</code>
          </div>
          <div class="det-section-title">Objects</div>
          <div id="detectionClassGrid" class="class-grid"></div>
          <div class="det-row">
            <button id="detectionApplyClassesBtn" class="small-btn">APPLY OBJECTS</button>
            <button id="detectionPresetBirdPlaneBtn" class="small-btn">BIRD + AIRPLANE</button>
            <button id="detectionAllClassesBtn" class="small-btn">ALL OBJECTS</button>
          </div>
          <code id="detectionClassesState">classes: all</code>
          <span style="opacity:.8">Detection ON/OFF runs YOLO. Objects choose classes. AREA controls full frame / ROI / tiled / hybrid search.</span>
        </div>
      </details>
      <div class="row" id="ptzConfigPanel">
        <label>PTZ Y⇅ <input id="ptzInvertTilt" type="checkbox"></label>
        <label>PTZ X⇄ <input id="ptzInvertPan" type="checkbox"></label>
        <label>Center X <input id="ptzTargetX" type="number" min="0.1" max="0.9" step="0.05" value="0.5"></label>
        <label>Center Y <input id="ptzTargetY" type="number" min="0.1" max="0.9" step="0.05" value="0.5"></label>
        <label>Min P <input id="ptzMinPan" type="number" min="0" max="20" step="1" value="4"></label>
        <label>Min T <input id="ptzMinTilt" type="number" min="0" max="20" step="1" value="3"></label>
        <button id="ptzApplyConfigBtn" class="small-btn">APPLY PTZ</button>
      </div>
      <details id="ptzSpeedTuneMenu" class="operator-menu compact">
        <summary>PTZ SPEED TUNE <code id="ptzSpeedTuneSummary">step=0 points=0</code></summary>
        <div class="menu-body" id="ptzSpeedTunePanel">
        <div><b>ZOOM SAMPLES:</b> <div id="ptzTuneSamplesRow" class="sample-row"></div></div>
        <button id="ptzTuneRehomeCurrentSampleBtn" class="small-btn" title="Backend nearest-edge rehome and return to current sample">REHOME CURRENT</button>

        <button id="ptzTuneSavePointBtn" class="small-btn">SAVE SPEED POINT</button>
        <button id="ptzTuneLoadPointBtn" class="small-btn">LOAD SPEED POINT</button>
        <button id="ptzTuneBuildProfileBtn" class="small-btn">BUILD SPEED CURVE</button>
        <button id="ptzTuneBuildFromZoomMasterBtn" class="small-btn">BUILD PTZ SPEED FROM ZOOM MASTER</button>

        <label>KP <input id="ptzTuneKp" type="number" step="0.1"></label>
        <label>KD <input id="ptzTuneKd" type="number" step="0.1"></label>
        <label>Max Pan <input id="ptzTuneMaxPan" type="number" step="1"></label>
        <label>Max Tilt <input id="ptzTuneMaxTilt" type="number" step="1"></label>
        <label>Max Accel <input id="ptzTuneMaxAccel" type="number" step="1"></label>
        <label>Min Pan <input id="ptzTuneMinPan" type="number" step="1"></label>
        <label>Min Tilt <input id="ptzTuneMinTilt" type="number" step="1"></label>
        <label>Deadzone <input id="ptzTuneDeadzone" type="number" step="0.001"></label>
        <label>PTZ Curve <input id="ptzTuneCurve" type="number" min="0.35" max="2.5" step="0.05" value="1.0"></label>
        <label>Lead ms <input id="ptzTuneLeadMs" type="number" min="0" max="500" step="10" value="0"></label>
        <label title="Pulse single-click pan command">Nudge Pan <input id="ptzTuneNudgePan" type="number" min="0" max="100" step="1" value="12"></label>
        <label title="Pulse single-click tilt command">Nudge Tilt <input id="ptzTuneNudgeTilt" type="number" min="0" max="100" step="1" value="12"></label>
        <button id="ptzTuneApplyConfigBtn" class="small-btn">APPLY SPEED</button>
        <label title="Duration of direct J pulse for keyboard micro movement">
          J Pulse ms
          <input id="ptzTuneJPulseMs" type="range" min="1" max="120" step="1" value="70" style="width:130px">
          <input id="ptzTuneJPulseMsNum" type="number" min="1" max="120" step="1" value="70" style="width:64px">
        </label>
        <label title="Keyboard PTZ behavior">
          Keyboard
          <select id="ptzTuneKeyboardMode" class="small-select">
            <option value="tap_hold" selected>TAP=PULSE / HOLD=SMOOTH</option>
            <option value="hold">HOLD SMOOTH</option>
            <option value="pulse">PULSE STEP</option>
          </select>
        </label>
        <code id="ptzTuneStatus">sample=0 zoom=0.00 focal=0 points=0 stepsSinceHome=0</code>
        <span style="opacity:.8">Workflow: click sample → tune/apply → SAVE SPEED POINT for sample.</span>
        </div>
      </details>
      <details id="zoomCalibMenu" class="operator-menu compact">
        <summary>ZOOM CALIB <code id="zoomCalibMenuSummary">anchor / profile</code></summary>
        <div class="menu-body" id="zoomAprilTagCalibPanel">
        <button id="zoomRunFullCalibBtn" class="small-btn" title="Clear old profiles, run all enabled anchors, build master profile, create PTZ speed profile">RUN FULL CALIB</button>
        <button id="zoomRunAprilTagCalibBtn" class="small-btn">RUN APRILTAG ZOOM CALIB</button>
        <button id="zoomBuildMasterProfileBtn" class="small-btn">BUILD MASTER PROFILE</button>
        <button id="apriltagTestBtn" class="small-btn">TEST APRILTAG</button>
        <div class="zoom-anchor-block">
          <strong>ZOOM ANCHORS</strong>
          <code id="zoomActiveAnchorSummary">active=near id=7 distance=1.00m size=160mm</code>
          <div class="zoom-anchor-row" data-anchor="near">
            <strong>Near / 1m</strong>
            <label><input id="zoomAnchorNearEnabled" type="checkbox" checked> enabled</label>
            <label>distance m <input id="zoomAnchorNearDistanceM" type="number" value="1" step="0.01"></label>
            <label>tag ID <input id="zoomAnchorNearTagId" type="number" value="7"></label>
            <label>size mm <input id="zoomAnchorNearSizeMm" type="number" value="160"></label>
            <button id="zoomSelectNearBtn" class="small-btn">SELECT NEAR</button>
            <button id="zoomRunNearBtn" class="small-btn">RUN NEAR</button>
          </div>
          <div class="zoom-anchor-row" data-anchor="mid">
            <strong>Mid / 5m</strong>
            <label><input id="zoomAnchorMidEnabled" type="checkbox" checked> enabled</label>
            <label>distance m <input id="zoomAnchorMidDistanceM" type="number" value="5" step="0.01"></label>
            <label>tag ID <input id="zoomAnchorMidTagId" type="number" value="-1"></label>
            <label>size mm <input id="zoomAnchorMidSizeMm" type="number" value="160"></label>
            <button id="zoomSelectMidBtn" class="small-btn">SELECT MID</button>
            <button id="zoomRunMidBtn" class="small-btn">RUN MID</button>
          </div>
          <div class="zoom-anchor-row" data-anchor="far">
            <strong>Far / 10m</strong>
            <label><input id="zoomAnchorFarEnabled" type="checkbox" checked> enabled</label>
            <label>distance m <input id="zoomAnchorFarDistanceM" type="number" value="10" step="0.01"></label>
            <label>tag ID <input id="zoomAnchorFarTagId" type="number" value="12"></label>
            <label>size mm <input id="zoomAnchorFarSizeMm" type="number" value="160"></label>
            <button id="zoomSelectFarBtn" class="small-btn">SELECT FAR</button>
            <button id="zoomRunFarBtn" class="small-btn">RUN FAR</button>
          </div>
        </div>
        <label>Movement
          <select id="zoomMoveMode">
            <option value="legacy_impulse">LEGACY IMPULSE</option>
            <option value="sweep_time_steps">SWEEP TIME STEPS</option>
          </select>
        </label>
        <label>Impulse ms <input id="zoomImpulseMs" type="number" value="170"></label>
        <label>Settle ms <input id="zoomSettleMs" type="number" value="250"></label>
        <label>Samples <input id="zoomSamples" type="number" value="12"></label>
        <label>Cmd <input id="zoomCmdAbs" type="number" value="34" min="1" max="100"></label>
        <label>Wide hold ms <input id="zoomWideHoldMs" type="number" value="3000" min="500" max="8000"></label>
        <label>Full sweep ms <input id="zoomFullSweepMs" type="number" value="3000" min="100" max="20000"></label>
        <label>Step ms <input id="zoomStepMsPreview" type="number" value="0" readonly></label>
        <label>Direction
          <select id="zoomCalibDirection">
            <option value="wide_to_tele">WIDE→TELE</option>
            <option value="tele_to_wide">TELE→WIDE</option>
          </select>
        </label>
        <label>Wide sign
