# Copy this file to launcher.cfg and tune limits/ports as needed.
# Values here are loaded by launcher.sh before defaults are applied.

# Camera command limits (degrees / steps)
CMD_MAX_PAN=20
CMD_MAX_TILT=20
CMD_MAX_ZOOM=25
MAX_DETECTIONS="${MAX_DETECTIONS:-10}"
MAX_RAW_CANDIDATES="${MAX_RAW_CANDIDATES:-50}"
DETECT_EVERY_N_FRAMES="${DETECT_EVERY_N_FRAMES:-1}"

# Optional transport settings
# UART_DEV=/dev/ttyUSB0
# UART_BAUD=115200
# WS_PORT=8765



# Autopilot PTZ defaults
AUTOPILOT_INVERT_PAN=0
AUTOPILOT_INVERT_TILT=1
AUTOPILOT_TARGET_X=0.5
AUTOPILOT_TARGET_Y=0.5
AUTOPILOT_MIN_PAN=4
AUTOPILOT_MIN_TILT=3